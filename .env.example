# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Copy this file to `.env` and fill in the values for local development.
# ==============================================================================

# Application general configurations
PORT=10000
NODE_ENV=development

# Database Configuration
# Use local MongoDB URI for Docker Compose or Local Dev
MONGO_URI=mongodb://localhost:27017/jj_db

# Security & Sessions
# Generate a highly secure random key using: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_here

# Cross-Origin Resource Sharing (CORS) Configuration
CORS_ORIGIN=http://localhost:3000